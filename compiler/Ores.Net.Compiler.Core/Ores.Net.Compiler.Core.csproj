<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- Embedded from the canonical source tree; never resolved via project
         paths or a runtime directory, and available to NativeAOT builds. -->
    <EmbeddedResource Include="../../library/atto.core/identity.atto"
                      LogicalName="Atto.Core.Identity" />
    <EmbeddedResource Include="../../contracts/atto-core-v1/numeric.atto"
                      LogicalName="Atto.Core.Numeric" />
    <EmbeddedResource Include="../../library/atto.core/slice.atto"
                      LogicalName="Atto.Core.Slice" />
    <EmbeddedResource Include="../../library/atto.core/iter.atto"
                      LogicalName="Atto.Core.Iter" />
    <EmbeddedResource Include="../../library/atto.core/cmp.atto"
                      LogicalName="Atto.Core.Cmp" />
  </ItemGroup>
  <!-- The production Native AOT compiler uses System.Reflection.Metadata only.
       Mono.Cecil remains a verification-only dependency, not a published runtime. -->
  <!-- Compiler-side host bootstrap binds typed actor layouts to the runtime,
       but guest actor methods remain fail-closed until verified lowering. -->
  <ItemGroup>
    <ProjectReference Include="../../runtime/Ores.Net.Runtime/Ores.Net.Runtime.csproj" />
  </ItemGroup>
</Project>
