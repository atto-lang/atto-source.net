// EXPECTED once genuinely compiled: stdout "true\n", exit 0.
// An actor's receive type does NOT imply its emitted value type.
define actor Parse as
    receive(ActorMail<int> mail): void {
        emit(mail.value > 0);
        return;
    }
end

define actor Validate as
    receive(ActorMail<bool> mail): void {
        if mail.value then
            emit(mail.value);
        fi
        return;
    }
end

define actor Sink as
    receive(ActorMail<bool> mail): void {
        stdio.println(mail.value);
        return;
    }
end

pub fnc main(): int {
    val chain = spawn Parse() pipe spawn Validate() | spawn Sink();
    chain.send(41);
    return 0;
}
