// EXPECTED once genuine backend lowering exists: stdout "42\n42\n", exit 0.
// Java/LLVM/.NET: semantic input only; do not claim compiled guest execution.
define actor Parse as
    receive(ActorMail<int> mail): void {
        emit(mail.value + 1);
        return;
    }
end

define actor Validate as
    receive(ActorMail<int> mail): void {
        if mail.value > 0 then
            emit(mail.value);
        fi
        return;
    }
end

define actor Sink as
    receive(ActorMail<int> mail): void {
        stdio.println(mail.value);
        return;
    }
end

pub fnc main(): int {
    val a = spawn Parse() | spawn Validate() | spawn Sink();
    val b = spawn Parse() pipe spawn Validate() pipe spawn Sink();
    a.send(41);
    b.send(41);
    return 0;
}
