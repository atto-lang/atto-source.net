// EXPECTED compile failure: E_ACTOR_PIPE_EMIT_TYPE; never emit native guest.
define actor Parse as
    receive(ActorMail<int> mail): void {
        if mail.value > 0 then
            emit(mail.value);
        else
            emit(true);
        fi
        return;
    }
end

define actor Sink as
    receive(ActorMail<int> mail): void {
        stdio.println(mail.value);
        return;
    }
end

pub fnc main(): int {
    val chain = spawn Parse() pipe spawn Sink();
    chain.send(41);
    return 0;
}
