// ACTOR_TWO_PEER_FAILURE_V1 — PROPOSED canonical AttoLang source, NOT EXECUTED.
// This is a future compiler acceptance target, NOT presently parser-valid.
// Two guest actor classes; one long-lived Witness and one fresh FaultWorker
// incarnation per scenario. Root is the trusted supervisor, not a third
// ordinary data-plane actor. No host-language emulation is a guest pass.
//
// UNRESOLVED SOURCE APIs (must be standardized BEFORE positive admission):
// FaultError constructor; FailureDisposition; defer recover syntax; spawn under
// supervisor; supervisor CONTROL observation; deterministic bounded done/error
// inspection. The conformance tests intentionally make no parser claims.

define pub class FaultError extends Error as
end

fnc non_tail_fault(int remaining): int {
  if remaining == 0 then
    return 0;
  fi
  // This MUST consume a checked guest logical frame each call. It must never
  // recurse into an unbounded CLR/JVM/native machine stack.
  return 1 + non_tail_fault(remaining - 1);
}

define pub actor Witness as
  state { value: int = 42; }

  @Implements
  receive(ActorMail<int> mail): void {
    const snapshot = self.handle_state(critical-read |s| -> s.value);
    if snapshot != 42 then
      panic FaultError("witness heap corrupted");
    fi
    self.send(snapshot);
    return;
  }
end

define pub actor FaultWorker as
  state { value: int = 7; }

  @Implements
  receive(ActorMail<int> mail): void {
    const snapshot = self.handle_state(critical-read |s| -> s.value);
    if mail.value == 90 then
      // A recovered actor retains the committed mutation from the failed
      // turn, proving it did NOT silently roll back or replay its mail.
      if snapshot != 1007 then
        panic FaultError("recovered actor state was lost");
      fi
      self.send(snapshot);
      return;
    fi
    if snapshot != 7 then
      panic FaultError("fault-worker heap corrupted");
    fi
    // Mutate ONLY the faulting actor's sealed heap before every fault.
    // Witness has its own untouched state and must still emit 42.
    const changed = self.handle_state(critical-write |s| -> {
      s.value = s.value + 1000;
      return s.value;
    });
    if changed != 1007 then
      panic FaultError("fault-worker heap write failed");
    fi

    if mail.value == 0 then
      // Ordinary throw: nearest matching catch wins, no fallback hook.
      try {
        throw FaultError("caught");
      } catch (FaultError failure) {
        self.send(100);
      }
      return;
    fi
    if mail.value == 1 then
      // Unhandled throw: once-only on_throw at actor-turn boundary.
      throw FaultError("uncaught");
    fi
    if mail.value == 2 then
      // Raise skips catch but nearest lexical recover callback handles it.
      defer recover |failure| -> {
        self.send(202);
        return FailureDisposition.recover;
      };
      try {
        raise FaultError("lexical recover");
      } catch (FaultError ignored) {
        panic FaultError("raise was caught as throw");
      }
      return;
    fi
    if mail.value == 3 then
      // Without lexical recover: on_raise runs once in an actor-local
      // bounded failure turn; it does not replay the failed message.
      raise FaultError("uncaught raise");
    fi
    if mail.value == 4 then
      // Even an explicit catch must NEVER intercept actor panic.
      try {
        panic FaultError("terminal panic");
      } catch (FaultError ignored) {
        self.send(999);
      }
      return;
    fi
    if mail.value == 5 then
      // Budget rejection must happen BEFORE native/carrier stack exhaustion.
      // A preinstalled lexical recover and catch are both forbidden.
      defer recover |failure| -> {
        self.send(998);
        return FailureDisposition.recover;
      };
      try {
        const impossible = non_tail_fault(100000);
        self.send(impossible);
      } catch (FaultError ignored) {
        self.send(999);
      }
      return;
    fi
    panic FaultError("unrecognized fault mode");
  }

  @Implements
  on_throw(failure: ThrowError): FailureDisposition {
    self.send(101);
    return FailureDisposition.recover;
  }

  @Implements
  on_raise(failure: RaiseError): FailureDisposition {
    self.send(203);
    return FailureDisposition.recover;
  }

  // Deliberately NO actor-local on_panic(). Panic skips actor hooks.
end

define pub supervisor Root as
  @Implements
  pub on_panic(failure: Failure): void {
    // Reserved authenticated parent CONTROL observation, never DATA mail.
    // A later compiler stage must bind child-id/incarnation/sequence and
    // publish one immutable notice to the trusted test observation channel.
    self.record_control(failure);
    return;
  }
end

// The following source is the acceptance target, NOT existing compiler API.
// Root.spawn_child creates a supervised child with authenticated incarnation;
// Root.control_events is reserved parent CONTROL observation only.
// The witness stays alive while a FRESH FaultWorker is created for each mode.
// Use bounded/test-runner deadlines to prevent a hang from being called PASS.
pub async routine main(): void {
  val root = spawn Root();
  await root.get_ready();
  val witness = await root.spawn_child(Witness());
  await witness.get_ready();

  let int mode = 0;
  while mode < 6 do
    val worker = await root.spawn_child(FaultWorker());
    await worker.get_ready();
    worker.send(mode);

    if mode < 4 then
      // Hooks/catch/recover send distinct typed values, not a generic PASS.
      val response = (await worker.outputs.next()).value.unwrap();
      const expected = if mode == 0 then 100
                       else if mode == 1 then 101
                       else if mode == 2 then 202
                       else 203 fi;
      if response.value != expected then
        panic FaultError("wrong throw/raise disposition");
      fi
      // An ordinary caught/recovered turn does not emit parent CONTROL.
      if root.control_event_count() != 0 then
        panic FaultError("unexpected supervisor control");
      fi
      // Recovery resumes NEXT message only; does not replay failing mail.
      worker.send(90);
      val healthy = (await worker.outputs.next()).value.unwrap();
      if healthy.value != 1007 then
        panic FaultError("actor not healthy after recovery");
      fi
      worker.end();
      await worker.get_done();
    else
      // Panic and guest-stack-budget exhaustion are terminal, never caught.
      val notice = (await root.control_events.next()).value.unwrap();
      if notice.child_id != worker.id then
        panic FaultError("forged supervisor child id");
      fi
      if notice.child_incarnation != worker.incarnation then
        panic FaultError("wrong supervisor incarnation");
      fi
      if notice.sequence != 1 then
        panic FaultError("duplicate or missing terminal notice");
      fi
      if mode == 4 then
        if notice.kind != #panic then
          panic FaultError("panic not delivered to CONTROL");
        fi
      else
        if notice.kind != #guest_stack_budget_exhausted then
          panic FaultError("stack budget was not bounded before native fault");
        fi
      fi
      // Both cases must make the child's old handles unusable.
      await worker.get_done();
      if worker.send(90).is_ok() then
        panic FaultError("stale terminated actor reference admitted");
      fi
    fi

    // A distinct actor heap persists after the sibling fails. This reply
    // MUST be generated by the Witness actor, not faked by the main process.
    witness.send(0);
    val observed = (await witness.outputs.next()).value.unwrap();
    if observed.value != 42 then
      panic FaultError("witness actor isolation failure");
    fi
    mode = mode + 1;
  end

  // The independent runner must ALSO inspect hook count/absence, actor heap
  // provenance, reserved CONTROL job receipt, bounded native stack, timeout,
  // non-replay and cleanup telemetry. Guest stdout alone is insufficient.
  witness.end();
  await witness.get_done();
  root.stop();
  await root.get_done();
  stdio.stdout.println("ACTOR_TWO_PEER_V1_OK|6|42");
  return;
}
