// ACTOR-REPLY-02/04/05: future compiler acceptance target, NOT_EXECUTED.
// Domain error and transport error remain nested (no auto-flattening).
define class GetUser implements UnaryRequest<Result<int, UserNotFound>> as
    const int user_id;
end

define actor Directory receives GetUser sends Result<int, UserNotFound> as
    receive(GetUser request) {
        // reply_to is contextual, not an ordinary serializable ActorRef.
        reply_to(request).send(Ok(42));
    }
end

pub susp fnc query_user(ActorRef<Directory> directory): Result<Result<int, UserNotFound>, RequestError> {
    // request is unary-only and retains Send versus Reply transport errors.
    return await directory.request(GetUser(42));
}
