// TARGET FIXTURE — source contract only, not a verified guest run.
define actor Producer receives int emits int as
  susp receive(ActorMail<int> mail): void {
    emit(mail.value);
  }
end
define actor Consumer receives int as
  susp receive(ActorMail<int> mail): void { }
end
pub susp fnc main(): int {
  val connection = spawn Consumer()
      rpipe Stream.buffered<int>(2)
      rpipe Channel<int>.bounded(1)
      rpipe spawn Producer();
  return 0;
}
