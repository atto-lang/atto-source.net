// Executed alongside byte-identical shared std HTTP and FS policy sources.
// This is compiled Atto -> CIL/NativeAOT, not C# policy emulation.
// Package import resolution and actual HTTP/FS runtime remain unsupported.
pub fnc main(): int {
  if http_status_valid(99) then return 1; fi
  if http_status_valid(100) == false then return 2; fi
  if http_status_valid(599) == false then return 3; fi
  if http_status_valid(600) then return 4; fi
  if http_status_success(199) then return 5; fi
  if http_status_success(299) == false then return 6; fi
  if http_status_redirect(301) == false then return 7; fi
  if http_status_client_error(404) == false then return 8; fi
  if http_status_server_error(503) == false then return 9; fi
  if http_get_status_may_have_body(204) then return 10; fi
  if http_get_status_may_have_body(205) then return 11; fi
  if http_get_status_may_have_body(304) then return 12; fi
  if http_get_status_may_have_body(404) == false then return 13; fi
  if fs_text_size_admissible(10, 10, 10) == false then return 14; fi
  if fs_text_size_admissible(11, 10, 100) then return 15; fi
  if fs_text_size_admissible(-1, 10, 10) then return 16; fi
  if fs_text_range_admissible(9, 2, 10) then return 17; fi
  if fs_text_range_admissible(9, 1, 10) == false then return 18; fi
  if fs_text_range_admissible(9223372036854775807, 1, 9223372036854775807) then return 19; fi
  if fs_text_replacement_admissible(4, 7, 5, 8) == false then return 20; fi
  if fs_text_replacement_admissible(4, 8, 5, 8) then return 21; fi
  if fs_text_replacement_admissible(1, 9223372036854775807, 1, 9223372036854775807) == false then return 22; fi
  return 42;
}
