// Only void payloads are permitted for do sync task. Inline int is still
// permitted as a value-producing expression without do.
pub fnc main(): int {
    do sync task<void> {
        do sync task {};
        do sync task<void> { return; };
        do sync task {};
        return;
    };
    return sync task<int> {
        do sync task<void> { return; };
        return 40 + 2;
    };
}
