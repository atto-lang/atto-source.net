// Candidate executable AttoLang operator parity on the .NET structured CFG
// lane. This is guest source compiled to CIL and then linked into NativeAOT,
// not a host-only computation or a generic interpreter.
fnc main():int {
    let int a = 7;
    let int b = 8;
    if a eq b { return 1; }
    if a neq b {
        if a !eq b {
            return (a + b) * 2 + 12; // 42
        }
    }
    return 0;
}
