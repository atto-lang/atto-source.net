// Source fixture for a FUTURE compiler-backed Atto telemetry admission test.
// Not a passing CI receipt: import/link and guest execution are not proven.
import Telemetry from "../../stdlib/telemetry.atto";

pub fnc main(): int {
  // W3C v00 decoded field admission.
  if !Telemetry.traceparent_v00_fields_valid(0, 1, 0, 7, 1) then return 1; fi
  if Telemetry.traceparent_v00_fields_valid(0, 0, 0, 7, 1) then return 2; fi
  if Telemetry.traceparent_v00_fields_valid(0, 1, 0, 0, 1) then return 3; fi
  if Telemetry.traceparent_v00_fields_valid(1, 1, 0, 7, 1) then return 4; fi
  if Telemetry.traceparent_v00_fields_valid(0, 1, 0, 7, 256) then return 5; fi
  if Telemetry.sampled_flag(2) then return 6; fi
  if !Telemetry.sampled_flag(3) then return 7; fi

  // Recording without sampling is distinct from drop and sampled recording.
  if Telemetry.sampling_decision(1, false) != 1 then return 8; fi
  if !Telemetry.decision_is_recording(1) then return 9; fi
  if Telemetry.decision_is_sampled(1) then return 10; fi
  if Telemetry.sampling_decision(3, true) != 2 then return 11; fi
  if Telemetry.sampling_decision(3, false) != 0 then return 12; fi

  // A stripped AOT image must never enable non-existent function probes.
  if Telemetry.dormant_probe_admissible(0, 1, true) then return 13; fi
  if Telemetry.dormant_probe_admissible(1, 2, true) then return 14; fi
  if Telemetry.dormant_probe_admissible(3, 3, false) then return 15; fi
  if !Telemetry.dormant_probe_admissible(3, 3, true) then return 16; fi
  if !Telemetry.span_window_valid(10, 10) then return 17; fi
  if Telemetry.span_window_valid(10, 9) then return 18; fi
  return 0;
}
