// Future .NET GUEST EXECUTION contract. Normal check/compile must reject
// until compiler-owned actor graph lowering and NativeAOT execution exist.
// The opt-in plan-actor-pipe command may type-check this source, but its
// scalar-only CIL oracle is NOT authenticated mailbox or actor execution.
// Expected when implemented: Producer(2) -> 3 -> Consumer(3) -> 6.
define actor Producer as
    on_message(int n): int { return n + 1; }
end

define actor Consumer as
    on_message(int n): int { return n * 2; }
end

pub fnc main(): int {
    let producer = spawn Producer();
    let consumer = spawn Consumer();
    producer pipe consumer;
    producer.send(2);
    stop producer;
    stop consumer;
    return 0;
}
