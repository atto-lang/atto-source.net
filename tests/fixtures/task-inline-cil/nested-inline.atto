pub fnc main(): int {
  let int count = 0;
  do sync task<void> {
    count = 1;
    do match true over
      on true -> { ^ void; }
      on false -> { count = 100; }
    end
    count = count + 1;
    return;
  }
  val Option<int> option = sync task<Option<int>> {
    do sync task {};
    val int number = sync task { return 40; };
    ^ Some(number);
  };
  return match option over
    on Some(number) -> { return number + count; }
    on None -> { return 0; }
  end;
}
