fnc scalar(bool first): int {
    let int count = 0;
    let int value = 0;
    value = match first over
        on true when false -> sync task<int> { count = 100; return 1; };
        on true -> sync task<int> { count = count + 2; return 40; };
        on false -> sync task<int> { count = count + 3; return 39; };
    end;
    return value + count;
}
fnc tagged(Option<int> subject): int {
    let int count = 0;
    val Option<int> state = match subject over
        on Some(n) -> sync task<Option<int>> { count = 2; return Some(n); };
        on None -> Some(42);
    end;
    return state.unwrap() + count;
}
pub fnc main(): int {
    guard scalar(true) eq 42, scalar(false) eq 42,
        tagged(Some(40)) eq 42, tagged(None) eq 42 { return 1; }
    return 42;
}
