// Portable, side-effect-free Oreslang client pacing primitives.
// This module does NOT authorize quota grants, mutate distributed counters,
// or certify the full uint64 rate-limit decision wire contract.
// Bounds mirror typescript/backpressure.mjs and fit losslessly in JavaScript.
define module backpressure as
  pub fnc valid_window(int quota, int policy_window_ms,
                       int remaining, int reset_after_ms): bool {
    return quota >= 1 && quota <= 1000000000 &&
           policy_window_ms >= 1 && policy_window_ms <= 2678400000 &&
           remaining >= 0 && remaining <= quota &&
           reset_after_ms >= 0 && reset_after_ms <= 2678400000;
  }

  // Portable unsigned-domain integer division using subtraction/doubling.
  // In Oreslang, int / int has FLOAT type, so it cannot compute exact
  // integer quota intervals. Bounded positive inputs ensure no i64 overflow.
  // This function is not a substitute for full uint64 wire arithmetic.
  fnc floor_div_non_negative(int numerator, int denominator): int {
    if numerator < 0 || numerator > 2678400000 ||
       denominator <= 0 || denominator > 2678400000; do
      return -1;
    fi
    let int remainder = numerator;
    let int quotient = 0;
    while remainder >= denominator {
      let int chunk = denominator;
      let int multiple = 1;
      while chunk <= remainder - chunk {
        chunk = chunk + chunk;
        multiple = multiple + multiple;
      }
      remainder = remainder - chunk;
      quotient = quotient + multiple;
    }
    return quotient;
  }

  // -1 means invalid input; 0 is never a valid pacing interval.
  // Prevalidated bounded operands make ceiling division safe on all targets.
  pub fnc conservative_window_interval_ms(int quota, int policy_window_ms,
                                           int remaining, int reset_after_ms): int {
    if !valid_window(quota, policy_window_ms, remaining, reset_after_ms); do
      return -1;
    fi
    val int policy_average = 1 + floor_div_non_negative(policy_window_ms - 1, quota);
    if remaining == 0; do
      if reset_after_ms > 1; do
        return max_interval(policy_average, reset_after_ms);
      fi
      return max_interval(policy_average, 1);
    fi
    if reset_after_ms == 0; do
      return max_interval(policy_average, 1);
    fi
    val int remaining_interval = 1 + floor_div_non_negative(reset_after_ms - 1, remaining);
    return max_interval(policy_average, remaining_interval);
  }

  pub fnc max_interval(int left, int right): int {
    if left > right; do return left; fi
    return right;
  }

  fnc min_interval(int left, int right): int {
    if left < right; do return left; fi
    return right;
  }

  fnc saturating_js_safe_add(int left, int right): int {
    if left > 9007199254740991 - right; do
      return 9007199254740991;
    fi
    return left + right;
  }

  // Retry-After is authoritative for pacing when present, including 0.
  // -1 denotes an absent Retry-After, not a negative HTTP delay.
  pub fnc required_delay_ms(int retry_after_ms, int derived_delay_ms): int {
    if derived_delay_ms < 0 || derived_delay_ms > 2678400000; do return -1; fi
    if retry_after_ms == -1; do return derived_delay_ms; fi
    if retry_after_ms < 0 || retry_after_ms > 2678400000; do return -1; fi
    return retry_after_ms;
  }

  // Monotonic not-before timestamp, saturating at JS MAX_SAFE_INTEGER.
  // A later response cannot advance dispatch or loosen an earlier backoff.
  pub fnc next_not_before_ms(int now_ms, int delay_ms,
                             int requested_jitter_ms,
                             int previous_not_before_ms): int {
    if now_ms < 0 || now_ms > 9007199254740991 ||
       previous_not_before_ms < 0 ||
       previous_not_before_ms > 9007199254740991 ||
       delay_ms < 0 || delay_ms > 2678400000 ||
       requested_jitter_ms < 0; do
      return -1;
    fi
    val int jitter_cap = floor_div_non_negative(delay_ms, 4);
    val int jitter = min_interval(requested_jitter_ms, jitter_cap);
    val int total_delay = delay_ms + jitter;
    val int candidate = saturating_js_safe_add(now_ms, total_delay);
    if previous_not_before_ms > candidate; do
      return previous_not_before_ms;
    fi
    return candidate;
  }

  // Suggested concurrency only tightens an existing client-side ceiling.
  // -1 is absence; 0 is invalid, never an instruction to allow no progress.
  pub fnc tightened_concurrency(int current_limit, int suggested_limit): int {
    if current_limit < 1 || current_limit > 1000000; do return -1; fi
    if suggested_limit == -1; do return current_limit; fi
    if suggested_limit < 1 || suggested_limit > 1000000; do return -1; fi
    if suggested_limit < current_limit; do return suggested_limit; fi
    return current_limit;
  }
end
