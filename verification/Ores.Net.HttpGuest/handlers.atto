define actor SharedHello as
  susp receive(ActorMail<String> mail): void {
    val request = http.claim(mail.value);
    request.set_header("X-Actor-Mode", "initial");
    request.set_header("x-actor-mode", "shared");
    request.set_header("X-Request-Id", request.request_id);
    await request.respond(200, "text/plain; charset=utf-8", "hello from shared actor");
    self.end();
    return;
  }
end

define isoactor IsolatedEcho as
  suspends receive(ActorMail<String> mail): void {
    val request = http.claim(mail.value);
    request.set_header("X-Actor-Mode", "isolated");
    val body = await request.body_text();
    request.set_header("X-Request-Id", request.request_id);
    await request.respond(201, "text/plain; charset=utf-8", body);
    self.end();
    return;
  }
end
