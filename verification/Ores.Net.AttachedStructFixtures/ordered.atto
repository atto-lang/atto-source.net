define struct Flag { bool value; } with { constructor(bool value) { self.value = value; } }
define struct Point { int x; int y; } with {
 constructor(int x, int y) { self.x = x; self.y = y; }
 mut mtd shift(int n):void { self.x = self.x + n; }
 mtd int • sum() { return self.x + self.y; }
 mtd int <- product() { return self.x * self.y; }
 mtd is_origin() -> bool { return self.x == 0 && self.y == 0; }
}
define struct Rectangle { Point a; Point b; } with {
 constructor(Point a, Point b) { self.a = a; self.b = b; }
 mut mtd shift(int n):void { self.a.x = self.a.x + n; self.b.y = self.b.y + self.a.x; }
 mtd area() -> int { return (self.b.x - self.a.x) * (self.b.y - self.a.y); }
}
pub fnc main():int { let mut p = Point(1, 2); let q = Point(4, 6); let mut Rectangle r = Rectangle(p,q); let snapshot = copy! r; p.shift(10); let f = Flag(p.is_origin()); let g = Flag(false && p.is_origin()); let before = Point(1,2); r.shift(r.a.x); return snapshot.area() * 100 + r.area() * 10 + p.sum() + before.sum(); }
