namespace counter;
declare pub actor FaultTaskCounter;
define state on actor FaultTaskCounter as { let int count: 0; }

pub suspends mtd (FaultTaskCounter counter) add(int incoming): int {
    val int saved = incoming;
    val Future<int> pending = task<int> { return 5 + 7; };
    val int result = await pending;
    val Future<int> next = task<int> { return 9223372036854775807 + 1; };
    val int second = await next;
    return self.handle_state(critical-write |s| -> {
        s.count = s.count + (saved + result + second);
        return s.count;
    });
}
