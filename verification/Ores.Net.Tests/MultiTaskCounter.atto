namespace counter;
declare pub actor MultiTaskCounter;
define state on actor MultiTaskCounter as { let int count: 0; }

pub suspends mtd (MultiTaskCounter counter) add(int incoming): int {
    val int saved = incoming;
    val Future<int> pending = task<int> { return 5 + 7; };
    val int result = await pending;
    val Future<int> next = task<int> { return 3 + 4; };
    val int second = await next;
    return self.handle_state(critical-write |s| -> {
        s.count = s.count + (saved + result + second);
        return s.count;
    });
}
