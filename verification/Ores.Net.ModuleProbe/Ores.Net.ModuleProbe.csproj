<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../runtime/Ores.Net.Runtime/Ores.Net.Runtime.csproj" />
    <Reference Include="OresGenerated">
      <HintPath>$(GeneratedAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireGeneratedAssembly" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GeneratedAssembly)' == '' or !Exists('$(GeneratedAssembly)')"
           Text="Pass an existing -p:GeneratedAssembly=/absolute/OresGenerated.dll" />
  </Target>
</Project>
