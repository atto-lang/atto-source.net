// Native Atto std/sync source-level state transition policies (.NET NativeAOT).
// NOT a mutex/rwlock/semaphore implementation: policy booleans cannot ensure
// atomic admission, fairness, cross-actor Sendable, wakeups or cancellation.
// The trusted scheduler must own actual handles, queues and release receipts.
// All counts and generation identifiers are nonnegative and bounded.
define module sync as
  pub fnc mutex_acquire_admissible(bool locked, bool closed,
                                   int waiting, int max_waiting): bool {
    if locked || closed then return false; fi
    // Do not let a newcomer bypass an already queued waiter.
    return waiting == 0 && max_waiting >= 0;
  }

  // A queued waiter prohibits fast-path acquisition, regardless of thread.
  pub fnc mutex_queue_admissible(bool closed, int waiting,
                                 int max_waiting): bool {
    if closed || waiting < 0 || max_waiting < 1 then return false; fi
    return waiting < max_waiting;
  }

  // Writer preference prevents a continuous reader stream from starving
  // an already queued writer. Actual queue ordering belongs to the runtime.
  pub fnc rw_read_admissible(int readers, bool writer_held,
                             int queued_writers, int max_readers): bool {
    if writer_held || readers < 0 || queued_writers != 0 then return false; fi
    if max_readers < 1 || readers >= max_readers then return false; fi
    return true;
  }

  pub fnc rw_write_admissible(int readers, bool writer_held): bool {
    return readers == 0 && !writer_held;
  }

  pub fnc rw_release_read_admissible(int readers): bool {
    return readers > 0;
  }

  // Permits and requested must be in [0, capacity]. A zero-permit take
  // succeeds but cannot be used to bypass queue ownership.
  pub fnc semaphore_acquire_admissible(int available, int requested,
                                       int capacity, bool closed): bool {
    if closed || capacity < 1 || available < 0 then return false; fi
    if available > capacity || requested < 1 then return false; fi
    return requested <= available;
  }

  // Use subtraction to avoid overflowing available + released.
  pub fnc semaphore_release_admissible(int available, int released,
                                       int capacity, bool closed): bool {
    // Return of a previously acquired permit remains valid during close.
    // Only the trusted runtime can attest that the caller owns the permit.
    if capacity < 1 || available < 0 then return false; fi
    if available > capacity || released < 1 then return false; fi
    return released <= capacity - available;
  }

  // parties is fixed during a barrier generation. The last arrival is
  // responsible for publishing the next generation through trusted runtime.
  pub fnc barrier_arrival_admissible(int arrived, int parties,
                                     bool broken): bool {
    if broken || parties < 1 || parties > 65536 then return false; fi
    return arrived >= 0 && arrived < parties;
  }

  pub fnc barrier_is_last(int arrived, int parties, bool broken): bool {
    if !barrier_arrival_admissible(arrived, parties, broken) then return false; fi
    return arrived == parties - 1;
  }

  pub fnc generation_successor_admissible(int current, int next): bool {
    if current < 0 || current >= 2147483647 then return false; fi
    return next == current + 1;
  }

  // These checks are NOT ownership verification. The trusted scheduler
  // must authenticate both owner and generation from a sealed receipt.
  // A consumed receipt must never release the lock twice.
  pub fnc mutex_release_receipt_admissible(bool held, int active_owner,
                                           int caller, int active_generation,
                                           int receipt_generation, bool consumed): bool {
    if !held || consumed || active_owner <= 0 then return false; fi
    if caller != active_owner then return false; fi
    if active_generation < 0 || receipt_generation < 0 then return false; fi
    return active_generation == receipt_generation;
  }

  // Writer-preference upgrade; exact ownership of the single read lease and
  // non-reentrant atomic transition remain runtime proof obligations.
  pub fnc rw_upgrade_admissible(int readers, bool writer_held,
                                int queued_writers, bool caller_has_read_lease): bool {
    if !caller_has_read_lease || writer_held then return false; fi
    return readers == 1 && queued_writers == 0;
  }

  pub fnc waiter_cancel_admissible(int waiting, int granted,
                                   int canceled): bool {
    if waiting < 0 || granted < 0 || canceled < 1 then return false; fi
    if granted > waiting then return false; fi
    return canceled <= waiting - granted;
  }

  // Public conformance-v1 names adapt to this backend's existing scheduler
  // admission policy; none of these functions can acquire a real lock.
  pub fnc mutex_take_admissible(bool held, bool closed, int queued): bool {
    return mutex_acquire_admissible(held, closed, queued, 0);
  }

  pub fnc mutex_enqueue_admissible(bool closed, int queued, int capacity): bool {
    return mutex_queue_admissible(closed, queued, capacity);
  }

  pub fnc read_take_admissible(int readers, bool writer_held,
                              int pending_writers, int reader_limit): bool {
    return rw_read_admissible(readers, writer_held, pending_writers, reader_limit);
  }

  pub fnc write_take_admissible(int readers, bool writer_held): bool {
    return rw_write_admissible(readers, writer_held);
  }

  pub fnc sem_take_admissible(int available, int requested, int capacity,
                             bool closed): bool {
    return semaphore_acquire_admissible(available, requested, capacity, closed);
  }

  pub fnc sem_return_admissible(int available, int released, int capacity,
                               bool closed): bool {
    return semaphore_release_admissible(available, released, capacity, closed);
  }

  pub fnc barrier_last_arrival(int arrived, int parties, bool broken): bool {
    return barrier_is_last(arrived, parties, broken);
  }

  pub fnc next_epoch_admissible(int current, int proposed): bool {
    return generation_successor_admissible(current, proposed);
  }
end
